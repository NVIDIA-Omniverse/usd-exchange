#include <winver.h>
#include <ntdef.h>

#include "include/usdex/core/Version.h"

#ifdef RC_INVOKED

// ------- version info -------------------------------------------------------

VS_VERSION_INFO VERSIONINFO
FILEVERSION             USDEX_VERSION_MAJOR,USDEX_VERSION_MINOR,USDEX_VERSION_PATCH
PRODUCTVERSION          USDEX_VERSION_MAJOR,USDEX_VERSION_MINOR,USDEX_VERSION_PATCH
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
        VALUE "CompanyName",      "@USDEX_COMPANY_NAME@"
        VALUE "ProductName",      "NVIDIA OpenUSD Exchange SDK"
        VALUE "FileDescription",  "NVIDIA OpenUSD Exchange SDK"
        VALUE "FileVersion",      USDEX_BUILD_STRING
        VALUE "ProductVersion",   USDEX_BUILD_STRING
        VALUE "LegalCopyright",   "Copyright (c) 2022-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409,1200
    END
END
#endif
