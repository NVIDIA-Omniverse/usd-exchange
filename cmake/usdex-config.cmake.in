@PACKAGE_INIT@

# OpenUSD Exchange SDK CMake package config. Provides imported targets `usdex::core` / `usdex::rtx`,
# plus usdex_target_link_usd() + the usdex_usd_headers target for consumers that call OpenUSD directly. Make USD
# discoverable via USDEX_USD_ROOT or CMAKE_PREFIX_PATH (we don't depend on pxrConfig.cmake).

# what this package was built against, for consumers to inspect
set(USDEX_PACKAGE_WITH_PYTHON @USDEX_WITH_PYTHON_INT@)
set(USDEX_PACKAGE_PYTHON_VERSION "@USDEX_PACKAGE_PYTHON_VERSION@")

include("${CMAKE_CURRENT_LIST_DIR}/usdex-targets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/UsdexCompilerConfig.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/UsdexUSD.cmake")

# consumers require OpenUSD (public headers include pxr); usdex_usd_headers exists only when UsdexUSD.cmake located it
if(NOT TARGET usdex_usd_headers)
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE "OpenUSD was not found. The OpenUSD Exchange SDK public headers include pxr headers, so set USDEX_USD_ROOT=<usd-install> or add the OpenUSD install prefix to CMAKE_PREFIX_PATH.")
    return()
endif()

# a Python-enabled OpenUSD reaches Python.h from its public headers, so consumers need the development files
# even when this package ships no bindings
if(USDEX_USD_WITH_PYTHON)
    usdex_find_python("${USDEX_PACKAGE_PYTHON_VERSION}")
endif()

# The usage requirements below append, so each target must receive them exactly once even though find_package may be
# called repeatedly. Imported targets are not global, so usdex-targets.cmake creates a fresh usdex::core and
# usdex::rtx in every directory scope that calls find_package: the state has to live on the targets themselves.
# Testing anything wider would skip the append for the second of two sibling directories that each call
# find_package, leaving its targets without the OpenUSD include directories.
foreach(_usdex_target usdex::core usdex::rtx)
    get_property(_usdex_usage_requirements_applied TARGET ${_usdex_target} PROPERTY USDEX_USAGE_REQUIREMENTS_APPLIED)
    if(NOT _usdex_usage_requirements_applied)
        set_property(TARGET ${_usdex_target} PROPERTY USDEX_USAGE_REQUIREMENTS_APPLIED TRUE)
        # propagate the USD includes + compile settings so consumers only need to link usdex::core / usdex::rtx
        set_property(TARGET ${_usdex_target} APPEND PROPERTY INTERFACE_LINK_LIBRARIES usdex_usd_headers usdex_build_options)
    endif()
endforeach()
unset(_usdex_target)
unset(_usdex_usage_requirements_applied)

# usdex_usd_headers is the opposite case: UsdexUSD.cmake creates it once for the whole build, so this append is
# guarded once for the whole build to match. That also keeps it in the scope that created the target, rather than
# relying on CMP0079 to reach it from a directory that only found the package.
# Python3::Module carries the include directory without libpython; usdex_target_link_usd() adds Python3::Python
# for targets that embed the interpreter
if(USDEX_USD_WITH_PYTHON)
    get_property(_usdex_python_applied GLOBAL PROPERTY USDEX_USD_HEADERS_PYTHON_APPLIED)
    if(NOT _usdex_python_applied)
        set_property(GLOBAL PROPERTY USDEX_USD_HEADERS_PYTHON_APPLIED TRUE)
        target_link_libraries(usdex_usd_headers INTERFACE Python3::Module)
    endif()
    unset(_usdex_python_applied)
endif()

check_required_components("${CMAKE_FIND_PACKAGE_NAME}")
